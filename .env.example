# JWT secret — change this to a long random string in production
JWT_SECRET=change-me-to-a-random-secret

# Cookie domain — set to .will-barnard.com in production so all subdomains share auth
COOKIE_DOMAIN=localhost

# Server port
PORT=3000

# Client origin for CORS (comma-separated for multiple origins)
CLIENT_ORIGIN=http://localhost:5173

# Super admin credentials (used by seed script on first run)
SUPER_ADMIN_EMAIL=admin@will-barnard.com
SUPER_ADMIN_PASSWORD=changeme123
